    {
      "id": "981bb292-f48d-47c1-85f3-ba2b194ee91c",
      "name": "Despachar respuesta al cliente (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1100,
        360
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Entrada (contrato)').first().json.email_cliente }}",
        "subject": "=Re: tu consulta a Lleyton Tech Store [{{ $('Entrada (contrato)').first().json.trace_id }}]",
        "emailType": "html",
        "message": "=<p>Hola {{ $('Entrada (contrato)').first().json.nombre || '' }},</p><p>{{ $('Entrada (contrato)').first().json.respuesta_final.replace(/\\n/g, '<br>') }}</p><hr><p style=\"color:#666;font-size:12px\">{{ $('Entrada (contrato)').first().json.origen_respuesta === 'AGENTE_AUTONOMO' ? 'Respuesta verificada por nuestro Supervisor de Calidad (exactitud ' + $('Entrada (contrato)').first().json.exactitud_factual + '/5).' : 'Respuesta revisada y aprobada por un supervisor de atención al cliente.' }} Código de seguimiento: {{ $('Entrada (contrato)').first().json.trace_id }}. Si necesitás hablar con una persona, respondé este correo.</p><p>Lleyton Tech Store · Soporte</p>",
        "options": {
          "appendAttribution": false,
          "senderName": "Lleyton Tech Store · Soporte"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "webhookId": "6c08df30-de9c-4052-ad32-e7ae7566d65c"
    },
