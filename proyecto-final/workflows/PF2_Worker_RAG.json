    {
      "id": "fad805e0-0137-4486-a7a3-517418615d18",
      "name": "Armar contexto RAG y fuentes (score ≥ 0,40)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entrada = $('Entrada (contrato)').first().json;\nconst MIN_SCORE = 0.40;\nconst docs = $input.all().map(i => i.json).filter(j => j.document && j.document.pageContent);\nconst relevantes = docs.filter(d => (d.score ?? 0) >= MIN_SCORE).sort((a, b) => b.score - a.score);\nconst fuentes = relevantes.map(d => {\n  const m = d.document.metadata || {};\n  return { documento: m.documento, version: m.version, vigencia: m.vigencia, seccion: String(m.seccion), titulo: m.titulo, pagina: Number(m.pagina), score: Math.round(d.score * 1000) / 1000 };\n});\nconst contexto = relevantes.map((d, i) => {\n  const m = d.document.metadata || {};\n  return '[Fragmento ' + (i + 1) + ' | ' + m.documento + ' v' + m.version + ' | Seccion ' + m.seccion + ' - ' + m.titulo + ' | pag. ' + m.pagina + ']\\n' + d.document.pageContent;\n}).join('\\n\\n');\nreturn [{ json: { ...entrada, contexto: contexto || '(sin fragmentos relevantes)', fuentes, hay_contexto: relevantes.length > 0, docs_recuperados: docs.length, top_score: relevantes.length ? relevantes[0].score : (docs[0] ? docs[0].score : 0) } }];"
      }
    },
