    {
      "id": "5c2413b7-1aea-4b8f-853c-fcd1df5583ef",
      "name": "buscar_vacantes_remotas",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [1488, 448],
      "parameters": {
        "toolDescription": "Consulta el board de empleos remotos Remotive. USALA cuando el usuario pida buscar o listar vacantes remotas por rol o area (data analyst, automation, sales). Devuelve titulo, empresa, ubicacion, salario y URL.",
        "method": "GET",
        "url": "https://remotive.com/api/remote-jobs",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": { "parameters": [{ "name": "search", "value": "={{ $fromAI('termino_busqueda', 'Rol o palabra clave a buscar') }}" }, { "name": "limit", "value": "5" }] },
        "optimizeResponse": true,
        "responseType": "json",
        "dataField": "jobs"
      }
    },
