    {
      "id": "d6c7f397-a0bd-4a44-a2dd-92d39bb3c85e",
      "name": "Preparar Resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2272, 112],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "const raw = $json.output !== undefined ? $json.output : $json.text;\nlet obj = raw;\nif (typeof raw === 'string') { try { obj = JSON.parse(raw); } catch (e) { obj = {}; } }\nobj = obj || {};\nconst puntos = Array.isArray(obj.puntos_clave) ? obj.puntos_clave : [];\nreturn [{ json: {\n  session_id: $('Contexto listo').first().json.sessionId,\n  message_count: $('Contexto listo').first().json.message_count,\n  fecha_actualizacion: new Date().toISOString(),\n  resumen_consolidado: JSON.stringify(obj),\n  estado_del_caso: obj.accion_requerida || 'en_seguimiento',\n  datos_clave: JSON.stringify(puntos)\n}}];" }
    },
