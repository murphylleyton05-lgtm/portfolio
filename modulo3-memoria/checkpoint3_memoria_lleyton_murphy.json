      "parameters": { "schemaType": "fromJson", "jsonSchemaExample": "{ \"asunto_principal\": \"El usuario busca vacantes de data analyst remoto con foco en IA/automation\", \"puntos_clave\": [\"Prefiere zona horaria LATAM\", \"Interesado en roles con salario publicado\"], \"accion_requerida\": \"Enviar 3 vacantes rankeadas en la proxima sesion\" }" }
