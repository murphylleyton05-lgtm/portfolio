Calc_UltOil]) / MIN({FIXED : SUM([Calc_UltOil])})" /></column><column caption="Grupo operador (dona)" datatype="string" name="[Calc_Grupo]" role="dimension" type="nominal"><calculation class='tableau' formula="CASE [Operador]&#10;WHEN 'YPF' THEN 'YPF'&#10;WHEN 'VISTA ENERGY' THEN 'Vista'&#10;WHEN 'PLUSPETROL' THEN 'Pluspetrol'&#10;WHEN 'SHELL' THEN 'Shell'&#10;WHEN 'PAN AMERICAN ENERGY' THEN 'PAE'&#10;ELSE 'Resto'&#10;END" /></column><column caption="Dona base" datatype="integer" name="[Calc_DonaBase]" role="measure" type="quantitative"><calculation class='tableau' formula="MIN(0)" /></column><column caption="Dona hueco" datatype="integer" name="[Calc_DonaHueco]" role="measure" type="quantitative"><calculation class='tableau' formula="MIN(0)" /></column><column caption="KPI petróleo (texto)" datatype="string" name="[Calc_TxtOil]" role="measure" type="nominal"><calculation class='tableau' formula='STR(INT(ROUND(SUM([Calc_UltOil]) / 1000, 0))) + " mil bbl/d"' /></column><column-instance column="[Calc_DonaBase]" derivation="User" name="[usr:Calc_DonaBase:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_DonaHueco]" derivation="User" name="[usr:Calc_DonaHueco:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_Grupo]" derivation="None" name="[none:Calc_Grupo:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_Share]" derivation="User" name="[usr:Calc_Share:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_TxtOil]" derivation="User" name="[usr:Calc_TxtOil:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_UltOil]" derivation="Sum" name="[sum:Calc_UltOil:qk]" pivot='key' type="quantitative" /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><encoding attr='space' class='0' field="[federated.0vacamuerta2025].[usr:Calc_DonaHueco:qk]" field-type='quantitative' fold='true' scope='rows' synchronized='true' type='space' /><format attr='display' clas