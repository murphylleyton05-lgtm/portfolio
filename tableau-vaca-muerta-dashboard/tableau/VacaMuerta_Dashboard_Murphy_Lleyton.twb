e="15">&lt;[federated.0vacamuerta2025].[usr:Calc_TxtOil:nk]&gt;</run><run>Æ&#10;</run><run fontcolor="#6b7680" fontname='Tableau Book' fontsize="9">dic-2025</run></formatted-text></customized-label><style><style-rule element='mark'><format attr="mark-labels-show" value="true" /><format attr="mark-color" value="#ffffff" /><format attr="size" value="2.4" /></style-rule></style></pane></panes><rows>([federated.0vacamuerta2025].[usr:Calc_DonaBase:qk] + [federated.0vacamuerta2025].[usr:Calc_DonaHueco:qk])</rows><cols></cols></table><simple-id uuid="{28C1EE2D-4855-5DE6-87DB-3879CC4C82C8}" /></worksheet><worksheet name="Treemap · Operadores"><layout-options><title><formatted-text><run bold='true' fontcolor="#333f48" fontname='Tableau Bold' fontsize="13">¿Cómo se distribuye la producción entre operadores? (dic-2025)</run><run>Æ&#10;</run><run fontcolor="#6b7680" fontname='Tableau Book' fontsize="9">Tamaño: petróleo (bbl/d) · Color: productividad por pozo · Hacé clic en un operador para filtrar el tablero; clic de nuevo para volver</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='Vaca Muerta · producción oficial' name="federated.0vacamuerta2025" /></datasources><datasource-dependencies datasource="federated.0vacamuerta2025"><column datatype="date" name="[Mes]" role="dimension" type="ordinal" /><column datatype="string" name="[Operador]" role="dimension" type="nominal" /><column datatype="integer" default-format="n#,##0" name="[Petroleo_bbl_d]" role="measure" type="quantitative" /><column datatype="integer" default-format="n#,##0" name="[Pozos_activos]" role="measure" type="quantitative" /><column caption="Petróleo último mes (bbl/d)" datatype="integer" default-format="n#,##0" name="[Calc_UltOil]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Petroleo_bbl_d] END" /></column><column caption="Pozos activos último mes" datatype="integer" default-format="n#,##0" name="[Calc_UltPozos]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Pozos_activos] END" /></column><column caption="Productividad (bbl/d por pozo)" datatype="real" default-format="n#,##0" name="[Calc_Prod]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Calc_UltOil]) / SUM([Calc_UltPozos])" /></column><column-instance column="[Calc_Prod]" derivation="User" name="[usr:Calc_Prod:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_UltOil]" derivation="Sum" name="[sum:Calc_UltOil:qk]" pivot='key' type="quantitative" /><column-instance column="[Operador]" derivation="None" name="[none:Operador:nk]" pivot='key' type="nominal" /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='mark'><encoding attr='color' field="[federated.0vacamuerta2025].[usr:Calc_Prod:qk]" type='interpolated'><color-palette custom='true' name='' type='ordered-sequential'><color>#a6b1bb</color><color>#1f4e79</color></color-palette></encoding></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Square" /><encodings><color column="[federated.0vacamuerta2025].[usr:Calc_Prod:qk]" /><size column="[federated.0vacamuerta2025].[sum:Calc_UltOil:qk]" /><text column="[federated.0vacamuerta2025].[none:Operador:nk]" /><text column="[federated.0vacamuerta2025].[sum:Calc_UltOil:qk]" /><text column="[federated.0vacamuerta2025].[usr:Calc_Prod:qk]" /></encodings><customized-label><formatted-text><run bold='true' fontcolor="#ffffff" fontname='Tableau Bold' fontsize="10">&lt;[federated.0vacamuerta2025].[none:Operador:nk]&gt;</run><run>Æ&#10;</run><run fontcolor="#ffffff" fontname='Tableau Book' fontsize="9">&lt;[federated.0vacamuerta2025].[sum:Calc_UltOil:qk]&gt;</run><run fontcolor="#ffffff" fontname='Tableau Book' fontsize="9"> bbl/d</run><run>Æ&#10;</run><run fontcolor="#ffffff" fontname='