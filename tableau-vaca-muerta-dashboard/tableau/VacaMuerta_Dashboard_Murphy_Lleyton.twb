pe="quantitative" /><column datatype="integer" default-format="n#,##0" name="[Petroleo_bbl_d_anio_anterior]" role="measure" type="quantitative" /><column datatype="real" default-format="n#,##0" name="[Gas_Mm3_d]" role="measure" type="quantitative" /><column datatype="integer" default-format="n#,##0" name="[Pozos_activos]" role="measure" type="quantitative" /><column caption="Petróleo último mes (bbl/d)" datatype="integer" default-format="n#,##0" name="[Calc_UltOil]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Petroleo_bbl_d] END" /></column><column caption="Petróleo mismo mes año anterior (bbl/d)" datatype="integer" default-format="n#,##0" name="[Calc_UltOilAnt]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Petroleo_bbl_d_anio_anterior] END" /></column><column caption="Gas último mes (Mm3/d)" datatype="real" name="[Calc_UltGas]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Gas_Mm3_d] END" /></column><column caption="Pozos activos último mes" datatype="integer" default-format="n#,##0" name="[Calc_UltPozos]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Pozos_activos] END" /></column><column caption="Var % interanual petróleo" datatype="real" default-format="p0.0%" name="[Calc_Var]" role="measure" type="quantitative"><calculation class='tableau' formula="(SUM([Calc_UltOil]) - SUM([Calc_UltOilAnt])) / SUM([Calc_UltOilAnt])" /></column><column caption="Productividad (bbl/d por pozo)" datatype="real" default-format="n#,##0" name="[Calc_Prod]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Calc_UltOil]) / SUM([Calc_UltPozos])" /></column><column caption="Participación % petróleo" datatype="real" default-format="p0%" name="[Calc_Share]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Calc_UltOil]) / MIN({FIXED : SUM([Calc_UltOil])})" /></column><column caption="Grupo operador (dona)" datatype="string" name="[Calc_Grupo]" role="dimension" type="nominal"><calculation class='tableau' formula="CASE [Operador]&#10;WHEN 'YPF' THEN 'YPF'&#10;WHEN 'VISTA ENERGY' THEN 'Vista'&#10;WHEN 'PLUSPETROL' THEN 'Pluspetrol'&#10;WHEN 'SHELL' THEN 'Shell'&#10;WHEN 'PAN AMERICAN ENERGY' THEN 'PAE'&#10;ELSE 'Resto'&#10;END" /></column><column caption="Tiene comparación interanual" datatype="boolean" name="[Calc_ConComp]" role="dimension" type="nominal"><calculation class='tableau' formula="NOT ISNULL([Petroleo_bbl_d_anio_anterior])" /></column><column caption="Dona base" datatype="integer" name="[Calc_DonaBase]" role="measure" type="quantitative"><calculation class='tableau' formula="MIN(0)" /></column><column caption="Dona hueco" datatype="integer" name="[Calc_DonaHueco]" role="measure" type="quantitative"><calculation class='tableau' formula="MIN(0)" /></column><column caption="KPI petróleo (texto)" datatype="string" name="[Calc_TxtOil]" role="measure" type="nominal"><calculation class='tableau' formula='STR(INT(ROUND(SUM([Calc_UltOil]) / 1000, 0))) + " mil bbl/d"' /></column><column caption="KPI variación (texto)" datatype="string" name="[Calc_TxtVar]" role="measure" type="nominal"><calculation class='tableau' formula='IF [Calc_Var] &gt;= 0 THEN "▲ +" ELSE "▼ " END + STR(ROUND([Calc_Var] * 100, 1)) + "% vs dic-2024"' /></column><column caption="KPI gas (texto)" datatype="string" name="[Calc_TxtGas]" role="measure" type="nominal"><calculation class='tableau' formula='STR(ROUND(SUM([Calc_UltGas]) / 1000, 1)) + " MMm³/d"' /></column><column caption="KPI pozos (texto)" datatype="string" name="[Calc_TxtPozos]" role="measure" type="nominal"><calculation class='tableau' formula='STR(INT(SUM([Calc_UltPozos]))) + " pozos"' /></column><column caption="KPI productividad (texto)" datatype="string" name="[Calc_TxtProd]" role="measure" type="nominal"><calculation class='tableau' formula='STR(INT(ROUND([Calc_Prod], 0))) + " bbl/d"' /></column><layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' /><style><style-rule element='mark'><encoding attr='color' field="[federated.0vacamuerta2025].[none:Calc_Grupo:nk]" type='palette'><map to="#e8833a"><bucket>&quot;YPF&quot;</bucket></map><map to="#1f4e79"><bucket>&quot;Vista&quot;</bucket></map><map to="#3d6a94"><bucket>&quot;Pluspetrol&quot;</bucket></map><map to="#5b86ae"><bucket>&quot;Shell&quot;</bucket></map><map to="#7fa3c4"><bucket>&quot;PAE&quot;</bucket></map><map to="#a6b1bb"><bucket>&quot;Resto&quot;</bucket></map></encoding></style-rule></style></datasource></datasources><actions><action caption='Filtrar tablero por operador' name='[Action_FiltroOperador]'><activation auto-clear='true' type='on-select' /><source dashboard="Dashboard Vaca Muerta" type='sheet' worksheet='Treemap · Operadores' /><command command='tsc:tsl-filter'><param name='exclude' value='Dona · Participación por operador' /><param name='special-fields' value='all' /><param name='target' value="Dashboard Vaca Muerta" /></command></action></actions><worksheets><worksheet name="KPI Petróleo"><table><view><datasources><datasource caption='Vaca Muerta · producción oficial' name="federated.0vacamuerta2025" /></datasources><datasource-dependencies datasource="federated.0vacamuerta2025"><column datatype="date" name="[Mes]" role="dimension" type="ordinal" /><column datatype="integer" default-format="n#,##0" name="[Petroleo_bbl_d]" role="measure" type="quantitative" /><column datatype="integer" default-format="n#,##0" name="[Petroleo_bbl_d_anio_anterior]" role="measure" type="quantitative" /><column caption="Petróleo último mes (bbl/d)" datatype="integer" default-format="n#,##0" name="[Calc_UltOil]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Mes] = {FIXED : MAX([Mes])} THEN [Petroleo_bbl_d] END" /></column><column caption="Petróleo mi