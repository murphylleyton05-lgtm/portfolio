table Fact_Ventas

	column id_venta
		dataType: int64
		sourceColumn: id_venta
		summarizeBy: sum

	column fecha_venta
		dataType: dateTime
		sourceColumn: fecha_venta
		summarizeBy: none

	column id_cliente
		dataType: int64
		sourceColumn: id_cliente
		summarizeBy: sum

	column id_producto
		dataType: int64
		sourceColumn: id_producto
		summarizeBy: sum

	column cantidad
		dataType: int64
		sourceColumn: cantidad
		summarizeBy: sum

	column precio_unitario
		dataType: double
		sourceColumn: precio_unitario
		summarizeBy: sum

	column descuento
		dataType: double
		sourceColumn: descuento
		summarizeBy: sum

	column total_venta
		dataType: double
		sourceColumn: total_venta
		summarizeBy: sum

	column canal
		dataType: string
		sourceColumn: canal
		summarizeBy: none

	column nombre_producto
		dataType: string
		sourceColumn: nombre_producto
		summarizeBy: none

	column categoria
		dataType: string
		sourceColumn: categoria
		summarizeBy: none

