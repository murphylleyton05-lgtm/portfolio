table Dim_Clientes

	column id_cliente
		dataType: int64
		sourceColumn: id_cliente
		summarizeBy: sum

	column nombre_cliente
		dataType: string
		sourceColumn: nombre_cliente
		summarizeBy: none

	column email
		dataType: string
		sourceColumn: email
		summarizeBy: none

	column ciudad
		dataType: string
		sourceColumn: ciudad
		summarizeBy: none

	column pais
		dataType: string
		sourceColumn: pais
		summarizeBy: none

	column fecha_registro
		dataType: dateTime
		sourceColumn: fecha_registro
		summarizeBy: none

	column canal
		dataType: string
		sourceColumn: canal
		summarizeBy: none

	partition Dim_Clientes = m
		mode: import
		source =
			let
			    Source = #table(
			        type table [id_cliente = Int64.Type, nombre_cliente = text, email = text, ciudad = text, pais = text, fecha_registro = date, canal = text],
