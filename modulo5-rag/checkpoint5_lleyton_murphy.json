      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        1700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const frag = $input.all().filter(i => typeof i.json.score === 'number' && i.json.document);\nconst pregunta = $('Chat de Prueba (test ciego)').first().json.chatInput;\nreturn [{ json: {\n  pregunta,\n  hay_fragmentos: frag.length > 0,\n  cantidad_fragmentos: frag.length,\n  scores: frag.map(f => Math.round(f.json.score * 100) / 100),\n  contexto: frag.map((f, i) => `[Fragmento ${i + 1} | score ${f.json.score.toFixed(2)}]\\n${f.json.document.pageContent}`).join('\\n\\n---\\n\\n')\n} }];"
      }
    },
