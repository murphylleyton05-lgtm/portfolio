# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env.local` y completá los valores.
# Sin ninguna variable la tienda arranca en MODO DEMO: se ve el catálogo de
# ejemplo pero no se pueden crear pedidos ni entrar al admin.
# En Vercel cargalas en Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la tienda, sin barra al final. En Vercel, si no la cargás,
# se usa automáticamente el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ── Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...). La "anon key" legacy también sirve.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). La "service_role key" legacy también sirve.
# ¡Nunca la expongas en el navegador ni la subas al repo!
SUPABASE_SECRET_KEY=

# ── Mercado Pago ── https://www.mercadopago.com.ar/developers/panel/app
# Access Token de la aplicación (usá el de prueba para testear).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tu aplicación → Webhooks → "Clave secreta").
# Si falta, igual se confirma el pago consultando la API, pero sin validar firma.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Resend (emails) ── https://resend.com/api-keys
# Sin esta clave los emails se imprimen en la consola del servidor.
RESEND_API_KEY=
# Remitente. Tiene que ser de un dominio verificado en Resend.
# Para pruebas podés usar: Tienda <onboarding@resend.dev> (solo envía a tu propio email).
EMAIL_FROM="Pampa Store <onboarding@resend.dev>"
